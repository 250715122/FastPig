<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.gt</groupId>
	<artifactId>FastPig</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>jar</packaging>

	<name>FastPig</name>
	<url>https://github.com/yourusername/FastPig</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <hadoop.version>2.5.0</hadoop.version>
        <hive.version>0.13.1</hive.version>
    </properties>

	<dependencies>
		<!-- Junit 4.x -->
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.10</version>
			<scope>test</scope>
		</dependency>

		<dependency>
		    <groupId>org.apache.logging.log4j</groupId>
		    <artifactId>log4j-core</artifactId>
		    <version>2.22.1</version>
		</dependency>
		<!-- 与 core 版本保持一致，兼容 Java 21 -->
		<dependency>
		    <groupId>org.apache.logging.log4j</groupId>
		    <artifactId>log4j-api</artifactId>
		    <version>2.22.1</version>
		</dependency>
		<!-- https://mvnrepository.com/artifact/com.melloware/jintellitype -->
		<dependency>
		    <groupId>com.melloware</groupId>
		    <artifactId>jintellitype</artifactId>
		    <version>1.3.9</version>
		</dependency>

		<dependency>
		    <groupId>net.java.dev.jna</groupId>
		    <artifactId>jna-platform</artifactId>
		    <version>5.4.0</version>
		</dependency>

		<dependency>
		    <groupId>net.java.dev.jna</groupId>
		    <artifactId>jna</artifactId>
		    <version>5.4.0</version>
		</dependency>

		<!-- JNativeHook - 现代化全局热键库 -->
		<dependency>
		    <groupId>com.1stleg</groupId>
		    <artifactId>jnativehook</artifactId>
		    <version>2.1.0</version>
		</dependency>

		<!-- SQLite JDBC -->
		<dependency>
		    <groupId>org.xerial</groupId>
		    <artifactId>sqlite-jdbc</artifactId>
		    <version>3.45.1.0</version>
		</dependency>

		<!-- Markdown Parser (flexmark) - 只引入实际需要的模块，避免引入 icu4j/pdfbox 等大依赖 -->
		<dependency>
		    <groupId>com.vladsch.flexmark</groupId>
		    <artifactId>flexmark</artifactId>
		    <version>0.64.8</version>
		</dependency>
		<!-- 表格扩展 -->
		<dependency>
		    <groupId>com.vladsch.flexmark</groupId>
		    <artifactId>flexmark-ext-tables</artifactId>
		    <version>0.64.8</version>
		</dependency>
		<!-- 属性扩展 -->
		<dependency>
		    <groupId>com.vladsch.flexmark</groupId>
		    <artifactId>flexmark-ext-attributes</artifactId>
		    <version>0.64.8</version>
		</dependency>
		<!-- HTML -> Markdown 转换（用于粘贴保留样式） -->
		<dependency>
		    <groupId>com.vladsch.flexmark</groupId>
		    <artifactId>flexmark-html2md-converter</artifactId>
		    <version>0.64.8</version>
		</dependency>


		<!-- JLaTeXMath for离线公式渲染到图片（适配JDK8） -->
		<dependency>
		    <groupId>org.scilab.forge</groupId>
		    <artifactId>jlatexmath</artifactId>
		    <version>1.0.7</version>
		</dependency>

		<!-- Sardine WebDAV Client for 坚果云同步 -->
		<dependency>
		    <groupId>com.github.lookfirst</groupId>
		    <artifactId>sardine</artifactId>
		    <version>5.10</version>
		</dependency>

		<!-- Lucene 9.x KNN 向量检索 -->
		<dependency>
		    <groupId>org.apache.lucene</groupId>
		    <artifactId>lucene-core</artifactId>
		    <version>9.10.0</version>
		</dependency>

		<!-- ONNX Runtime for 本地 Embedding 推理 -->
		<dependency>
		    <groupId>com.microsoft.onnxruntime</groupId>
		    <artifactId>onnxruntime</artifactId>
		    <version>1.17.0</version>
		</dependency>

	</dependencies>
	
  <build>
    <sourceDirectory>src/main/java</sourceDirectory>
    <testSourceDirectory>src/main/test</testSourceDirectory>
	<defaultGoal>compile</defaultGoal>
	
    <plugins>
      <!-- 编译插件配置 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <source>21</source>
          <target>21</target>
          <encoding>UTF-8</encoding>
        </configuration>
      </plugin>
      
      <!-- 资源插件，确保DLL文件被复制 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.2.0</version>
        <executions>
          <execution>
            <id>copy-dll-files</id>
            <phase>compile</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/com/melloware/jintellitype</outputDirectory>
              <resources>
                <resource>
                  <directory>src/main/java/com/melloware/jintellitype</directory>
                  <includes>
                    <include>*.dll</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      
      <!-- maven-shade-plugin: 打包并裁剪非 Windows 平台的本地库 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.gt.FastPigApplication</mainClass>
                  <manifestEntries>
                    <Multi-Release>true</Multi-Release>
                  </manifestEntries>
                </transformer>
                <!-- 合并 Log4j 插件缓存文件 -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/org/apache/logging/log4j/core/config/plugins/Log4j2Plugins.dat</resource>
                </transformer>
              </transformers>
              <filters>
                <!-- ONNX Runtime: 只保留 Windows 平台本地库 -->
                <filter>
                  <artifact>com.microsoft.onnxruntime:onnxruntime</artifact>
                  <excludes>
                    <exclude>ai/onnxruntime/native/linux-*/**</exclude>
                    <exclude>ai/onnxruntime/native/osx-*/**</exclude>
                  </excludes>
                </filter>
                <!-- SQLite JDBC: 只保留 Windows 平台本地库 -->
                <filter>
                  <artifact>org.xerial:sqlite-jdbc</artifact>
                  <excludes>
                    <exclude>org/sqlite/native/Linux/**</exclude>
                    <exclude>org/sqlite/native/Linux-Android/**</exclude>
                    <exclude>org/sqlite/native/Linux-Musl/**</exclude>
                    <exclude>org/sqlite/native/Mac/**</exclude>
                    <exclude>org/sqlite/native/FreeBSD/**</exclude>
                  </excludes>
                </filter>
                <!-- JNA: 只保留 Windows 平台本地库 -->
                <filter>
                  <artifact>net.java.dev.jna:jna</artifact>
                  <excludes>
                    <exclude>com/sun/jna/linux-*/**</exclude>
                    <exclude>com/sun/jna/darwin*/**</exclude>
                    <exclude>com/sun/jna/freebsd-*/**</exclude>
                    <exclude>com/sun/jna/openbsd-*/**</exclude>
                    <exclude>com/sun/jna/sunos-*/**</exclude>
                    <exclude>com/sun/jna/aix-*/**</exclude>
                  </excludes>
                </filter>
                <!-- 排除签名文件，避免安全异常 -->
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <!-- 生成的 jar 文件名后缀 -->
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>jar-with-dependencies</shadedClassifierName>
            </configuration>
          </execution>
        </executions>
      </plugin>
      
      <!-- 
        注意：EXE 生成使用 jpackage 工具（Java 14+自带）
        请参考项目根目录的 build-exe.bat 脚本
      -->

    </plugins>
  </build>
	
</project>
